{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "bolt.yaml",
  "description": "Bolt pipeline contract. version is 1. Unreal engine, project, uproject, and targets belong under the ue plugin config.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project"],
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "vars": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/stepList"
      },
      "default": {}
    },
    "flows": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/flow"
      },
      "default": {}
    },
    "plugins": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/plugin"
      }
    },
    "timeout_hours": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "notifications": {
      "$ref": "#/$defs/notifications"
    }
  },
  "$defs": {
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "vcs": {
          "enum": ["git", "svn"],
          "default": "git"
        },
        "url": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        }
      }
    },
    "ueTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["editor", "program", "game", "client", "server"]
        },
        "name": {
          "type": "string"
        },
        "config": {
          "type": "string",
          "pattern": "^\\s*(?:[Dd][Ee][Vv][Ee][Ll][Oo][Pp][Mm][Ee][Nn][Tt]|[Dd][Ee][Vv]|[Dd][Ee][Bb][Uu][Gg]|[Dd][Bb][Gg]|[Dd][Ee][Bb][Uu][Gg][Gg][Aa][Mm][Ee]|[Dd][Bb][Gg][Gg][Aa][Mm][Ee]|[Ss][Hh][Ii][Pp][Pp][Ii][Nn][Gg]|[Tt][Ee][Ss][Tt])\\s*$",
          "description": "Build configuration. Same names bolt check accepts, in any case, with surrounding space allowed."
        }
      }
    },
    "ueConfig": {
      "description": "Unreal metadata. Valid only under plugins[].config when namespace is ue, never as a root bolt.yaml field.",
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "project", "uproject"],
      "properties": {
        "engine": {
          "$ref": "#/$defs/repo"
        },
        "project": {
          "$ref": "#/$defs/repo"
        },
        "uproject": {
          "type": "string",
          "minLength": 1
        },
        "targets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ueTarget"
          },
          "default": {}
        }
      }
    },
    "svnConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "use_tortoise": {
          "type": "boolean"
        }
      }
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["uses"],
          "properties": {
            "uses": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "^task/"
              }
            },
            "with": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "continue-on-error": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["call"],
          "properties": {
            "call": {
              "type": "string",
              "minLength": 1
            },
            "with": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "continue-on-error": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["run"],
          "properties": {
            "run": {
              "type": "string",
              "minLength": 1
            },
            "continue-on-error": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "stepList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "description": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "continue_on_fail": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "plugin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "config"],
          "properties": {
            "namespace": {
              "type": "string",
              "const": "ue"
            },
            "path": {
              "type": "string"
            },
            "config": {
              "$ref": "#/$defs/ueConfig"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace"],
          "properties": {
            "namespace": {
              "type": "string",
              "const": "svn"
            },
            "path": {
              "type": "string"
            },
            "config": {
              "$ref": "#/$defs/svnConfig"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace"],
          "properties": {
            "namespace": {
              "type": "string",
              "not": {
                "enum": ["ue", "svn"]
              }
            },
            "path": {
              "type": "string"
            },
            "config": {
              "type": "object"
            }
          }
        }
      ]
    },
    "wecom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "webhook_url"],
      "properties": {
        "type": {
          "const": "wecom"
        },
        "webhook_url": {
          "type": "string"
        },
        "chat_id": {
          "type": "string"
        }
      }
    },
    "telegram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "bot_token", "chat_id"],
      "properties": {
        "type": {
          "const": "telegram"
        },
        "bot_token": {
          "type": "string"
        },
        "chat_id": {
          "type": "string"
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on_start": {
          "type": "boolean",
          "default": true
        },
        "on_op_complete": {
          "type": "boolean",
          "default": true
        },
        "on_failure": {
          "type": "boolean",
          "default": true
        },
        "on_complete": {
          "type": "boolean",
          "default": true
        },
        "providers": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/wecom"
              },
              {
                "$ref": "#/$defs/telegram"
              }
            ]
          },
          "default": []
        }
      }
    }
  }
}
