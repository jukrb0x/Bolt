{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "bolt.yaml",
  "description": "Bolt pipeline contract. version is 1. Plugin config is opaque: each plugin validates its own config.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project"],
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "vars": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/stepList"
      },
      "default": {}
    },
    "flows": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/flow"
      },
      "default": {}
    },
    "plugins": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/plugin"
      }
    },
    "capabilities": {
      "type": "object",
      "description": "Singleton capability tag to handler ref (namespace/handler). bolt.local.yaml wins per key. An empty object is the same as omitting the key. Fan-out tags are ignored with one warning.",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "default": {}
    },
    "workspace": {
      "$ref": "#/$defs/workspace"
    },
    "timeout_hours": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "notifications": {
      "$ref": "#/$defs/notifications"
    }
  },
  "$defs": {
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["uses"],
          "properties": {
            "uses": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "^task/"
              }
            },
            "with": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "continue-on-error": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["call"],
          "properties": {
            "call": {
              "type": "string",
              "minLength": 1
            },
            "with": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "continue-on-error": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["run"],
          "properties": {
            "run": {
              "type": "string",
              "minLength": 1
            },
            "continue-on-error": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "stepList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "description": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "continue_on_fail": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace"],
      "properties": {
        "namespace": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "description": "Opaque plugin config. Core does not interpret these fields. The plugin validates them."
        }
      }
    },
    "workspaceRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "role"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Relative to the directory that contains bolt.yaml, or an absolute path. bolt.local.yaml does not override it"
        },
        "role": {
          "enum": ["engine", "project", "related"]
        },
        "vcs": {
          "type": "string",
          "minLength": 1,
          "description": "Optional version-control namespace. Omit it when the root has none. bolt list and bolt check do not call it"
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roots"],
      "description": "Optional multi-root inventory. bolt list and bolt check read these roots. They do not update a working copy. sync_policy is rejected: remove it. Daily multi-repo update stays pipeline + vcs.sync.",
      "properties": {
        "roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/workspaceRoot"
          }
        }
      }
    },
    "wecom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "webhook_url"],
      "properties": {
        "type": {
          "const": "wecom"
        },
        "webhook_url": {
          "type": "string"
        },
        "chat_id": {
          "type": "string"
        }
      }
    },
    "telegram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "bot_token", "chat_id"],
      "properties": {
        "type": {
          "const": "telegram"
        },
        "bot_token": {
          "type": "string"
        },
        "chat_id": {
          "type": "string"
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on_start": {
          "type": "boolean",
          "default": true
        },
        "on_op_complete": {
          "type": "boolean",
          "default": true
        },
        "on_failure": {
          "type": "boolean",
          "default": true
        },
        "on_complete": {
          "type": "boolean",
          "default": true
        },
        "providers": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/wecom"
              },
              {
                "$ref": "#/$defs/telegram"
              }
            ]
          },
          "default": []
        }
      }
    }
  }
}
