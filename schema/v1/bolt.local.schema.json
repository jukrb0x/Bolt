{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "bolt.local.yaml",
  "description": "Per-machine overrides (gitignored). vars override bolt.yaml vars. plugins.<namespace> is deep-merged over the config of the bolt.yaml plugin with that namespace before validation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "vars": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "plugins": {
      "type": "object",
      "properties": {
        "ue": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "engine": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "vcs": {
                  "enum": ["git", "svn"],
                  "default": "git"
                },
                "url": {
                  "type": "string"
                },
                "branch": {
                  "type": "string"
                },
                "version": {
                  "enum": [4, 5, "4", "5"],
                  "description": "Unreal Engine major version. Omit to detect it from Engine/Build/Build.version, then from which editor binaries exist."
                }
              }
            },
            "project": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "vcs": {
                  "enum": ["git", "svn"],
                  "default": "git"
                },
                "url": {
                  "type": "string"
                },
                "branch": {
                  "type": "string"
                }
              }
            },
            "editor_target": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_]+$",
              "description": "Editor target and executable base name, e.g. UnrealEditor or UE4Editor. Overrides the name implied by engine.version."
            },
            "uproject": {
              "type": "string",
              "minLength": 1
            },
            "targets": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/partialUeTarget"
              }
            }
          }
        },
        "svn": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "use_tortoise": {
              "type": "boolean"
            }
          }
        }
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "partialUeTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["editor", "program", "game", "client", "server"]
        },
        "name": {
          "type": "string"
        },
        "config": {
          "type": "string",
          "pattern": "^\\s*(?:[Dd][Ee][Vv][Ee][Ll][Oo][Pp][Mm][Ee][Nn][Tt]|[Dd][Ee][Vv]|[Dd][Ee][Bb][Uu][Gg]|[Dd][Bb][Gg]|[Dd][Ee][Bb][Uu][Gg][Gg][Aa][Mm][Ee]|[Dd][Bb][Gg][Gg][Aa][Mm][Ee]|[Ss][Hh][Ii][Pp][Pp][Ii][Nn][Gg]|[Tt][Ee][Ss][Tt])\\s*$",
          "description": "Build configuration. Same names bolt check accepts, in any case, with surrounding space allowed."
        }
      }
    }
  }
}
